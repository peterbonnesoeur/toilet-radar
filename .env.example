# Copy to .env.local (and optionally .env.dev / .env.prd for those environments).
# Which file gets loaded is chosen by APP_ENV (local | dev | prd), default: local.
# Both the Python side (db/config.py) and the Node scripts (scripts/*.mjs) use
# this convention. Production is never targeted implicitly.

# --- Next.js app (browser-safe) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Data-import scripts only (NEVER expose to the browser) ---
SUPABASE_SERVICE_KEY=your-service-role-key

# --- Direct Postgres connection (Alembic migrations) ---
# From Supabase Dashboard > Settings > Database > Connection string.
# Either a single URL:
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# ...or individual components:
DB_HOST=aws-0-region.pooler.supabase.com
DB_PORT=6543
DB_NAME=postgres
DB_USER=postgres.your-project-ref
DB_PASSWORD=your-database-password
